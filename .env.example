# 1. Google Gemini API Key (Lấy tại: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Chuỗi kết nối PostgreSQL (Format: postgresql://username:password@host:port/database_name)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/ictu_tower
